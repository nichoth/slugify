{
	"name": "@substrate-system/slugify",
	"version": "3.0.0",
	"description": "Slugify a string",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./overridable-replacements": {
			"types": "./dist/overridable-replacements.d.ts",
			"default": "./dist/overridable-replacements.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"start": "vite",
		"build-esm": "esbuild src/*.ts --format=esm --metafile=dist/meta.json --keep-names --tsconfig=tsconfig.build.json --outdir=./dist --sourcemap && tsc --emitDeclarationOnly --project tsconfig.build.json --outDir dist",
		"build-esm:min": "esbuild ./src/*.ts --format=esm --keep-names --bundle --tsconfig=tsconfig.build.json --minify --out-extension:.js=.min.js --outdir=./dist --sourcemap",
		"build": "mkdir -p ./dist && rm -rf ./dist/* && npm run build-esm && npm run build-esm:min",
		"build-example": "mkdir -p ./public && rm -rf ./public/* && vite --base=\"/slugify\" build",
		"test": "npm run build && xo && ava",
		"toc": "markdown-toc --maxdepth 3 -i README.md",
		"prepublishOnly": "npm run build",
		"preversion": "npm run lint",
		"version": "npm run toc && auto-changelog -p --template keepachangelog --breaking-pattern 'BREAKING CHANGE:' && git add CHANGELOG.md README.md",
		"postversion": "git push --follow-tags && npm publish"
	},
	"files": [
		"./dist/*"
	],
	"dependencies": {
		"@sindresorhus/transliterate": "^2.0.0",
		"escape-string-regexp": "^5.0.0"
	},
	"devDependencies": {
		"auto-changelog": "^2.6.0",
		"ava": "^6.4.1",
		"esbuild": "^0.28.2",
		"markdown-toc": "^1.2.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.6",
		"xo": "^1.2.2"
	},
	"xo": {
		"rules": {
			"@typescript-eslint/member-ordering": "off"
		}
	},
	"keywords": [
		"string",
		"slugify",
		"slug",
		"url",
		"url-safe",
		"urlify",
		"transliterate",
		"transliteration",
		"deburr",
		"unicode",
		"ascii",
		"text",
		"decamelize",
		"pretty",
		"clean",
		"filename",
		"id"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nichoth/slugify.git"
	},
	"bugs": {
		"url": "https://github.com/nichoth/slugify/issues"
	},
	"homepage": "https://github.com/nichoth/slugify",
	"funding": "https://github.com/sponsors/sindresorhus",
	"author": {
		"name": "Sindre Sorhus",
		"email": "sindresorhus@gmail.com",
		"url": "https://sindresorhus.com"
	}
}
